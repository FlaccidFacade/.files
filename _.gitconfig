[user]
    name = FlaccidFacade
    email = google.scientist979@simplelogin.com

[alias]
    c = "!f() { if [ \"$1\" = \"pop\" ]; then shift; git reset HEAD~1 \"$@\"; else git commit \"$@\"; fi; }; f"
    s = status
    co = checkout
    br = branch
    a = add
    d = diff
    l = log --oneline --graph
    ps = push
    pl = pull
    f = fetch
    m = merge
    r = reset
    # This is the new line to make 'git stash' default to 'push'
    stash = "!git stash push"
